# Used when you open the site on this PC.
# Delete this line to follow the page host on port 8000. That is required when
# another device opens http://<lan-ip>:5173:
#   ${location.protocol}//${location.hostname}:8000/api
VITE_API_BASE_URL=http://127.0.0.1:8000/api

# Same value as REVERB_APP_KEY in backend/.env.
# Leave VITE_REVERB_HOST unset so the socket uses the page hostname (required
# when another device opens the site). Port 8080 is the local Reverb server.
VITE_REVERB_APP_KEY=teletech-local-key
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http
