APP_NAME="TeleTech Drivers API"
# Use APP_ENV=local and APP_DEBUG=true on a development machine.
# A production copy must set APP_ENV=production, APP_DEBUG=false, and
# CORS_ALLOWED_ORIGINS to the real website origin. LAN defaults are off in production.
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_BUSINESS_TIMEZONE=Africa/Cairo

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=teletech
DB_USERNAME=teletech
DB_PASSWORD=teletech

SESSION_DRIVER=array
SESSION_LIFETIME=120

# reverb is the local WebSocket server (php artisan reverb:start).
BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
# database so push jobs run in `php artisan queue:work` (npm run dev / dev:all).
QUEUE_CONNECTION=database

# Self-hosted Reverb. PHP posts events to REVERB_HOST (this machine).
# The WebSocket server listens on REVERB_SERVER_HOST so phones on the LAN can connect.
# Keep REVERB_APP_KEY identical to VITE_REVERB_APP_KEY in web/.env.
REVERB_APP_ID=teletech
REVERB_APP_KEY=teletech-local-key
REVERB_APP_SECRET=teletech-local-secret
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

CACHE_STORE=file

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@teletech.local"
MAIL_FROM_NAME="${APP_NAME}"

# Comma-separated browser origins allowed to call the API.
# Outside production, an empty value allows http://localhost:* and http://127.0.0.1:*.
# Production must set explicit origins, for example https://admin.example.com.
# Private LAN patterns are not applied when APP_ENV=production.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional comma-separated preg_match patterns (include delimiters; do not put commas inside a pattern).
# When this is empty and APP_ENV is not production, http and https are allowed on any port for
# localhost, 127.0.0.1, 192.168.x.x, 10.x.x.x, and 172.16-31.x.x.
# A non-empty value replaces that list. Production stays closed unless you set it.
# CORS_ALLOWED_ORIGINS_PATTERNS=

# Sanctum personal access token lifetime (minutes)
SANCTUM_TOKEN_EXPIRATION_MINUTES=10080

# FCM HTTP v1 service account. Path is relative to the backend directory.
# Leave empty to log a warning and skip push delivery.
FIREBASE_CREDENTIALS=storage/app/firebase/service-account.json

# Optional fleet overrides. Omit them to keep the defaults in config/fleet.php and config/teletech.php.
# FLEET_WEEK_STARTS_ON=Saturday
# TELETECH_LOCATION_STALE_SECONDS=60
# TELETECH_HQ_NEAR_METERS=200
# TELETECH_HQ_MEDIUM_METERS=1000
# TELETECH_SCHEDULE_CONFLICT_WINDOW_HOURS=2
# TELETECH_LOCATION_ACCURACY_MAX_METERS=50
# TELETECH_LOCATION_FIRST_PUBLISH_ACCURACY_MAX_METERS=500
# TELETECH_POLYLINE_MAX_LENGTH=100000
# TELETECH_DRIVER_LOCATION_THROTTLE_PER_MINUTE=12

# Headquarters attendance QR. Coordinates are Company Headquarters.
# Weekly off days use 0=Sunday … 6=Saturday. 5 is Friday.
# Leave ATTENDANCE_QR_SECRET empty to derive it from APP_KEY.
# Raise ATTENDANCE_QR_VERSION to invalidate printed codes.
ATTENDANCE_HQ_LAT=30.0444
ATTENDANCE_HQ_LNG=31.2357
ATTENDANCE_HQ_NAME="Company Headquarters"
ATTENDANCE_RADIUS_M=150
ATTENDANCE_MAX_ACCURACY_M=50
ATTENDANCE_WEEKLY_OFF_DAYS=5
ATTENDANCE_QR_SECRET=
ATTENDANCE_QR_VERSION=1

# Seeded privileged accounts (required for php artisan db:seed)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_COMPANY_ADMIN_EMAIL=
SEED_COMPANY_ADMIN_PASSWORD=
SEED_DRIVERS_ADMIN_EMAIL=
SEED_DRIVERS_ADMIN_PASSWORD=

# Optional local DevSeeder password (local APP_ENV only)
SEED_DEV_PASSWORD=password
